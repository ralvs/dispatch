# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API Keys (new key naming: publishable + secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Authentication → Users → your user's UUID. The only account allowed in.
OWNER_USER_ID=

# ── AI (Vercel AI Gateway — the only AI key in the project) ────────────────
AI_GATEWAY_API_KEY=
# Optional model overrides (defaults in lib/env.ts)
# PARSER_MODEL=anthropic/claude-haiku-4.5
# CHAT_MODEL=anthropic/claude-sonnet-5

# ── External surface secrets (openssl rand -hex 32) ────────────────────────
# CAPTURE_WEBHOOK_SECRET guards the one external surface, POST /api/capture:
# a bare URL becomes a row at /links, anything else runs the capture parser
# (docs/adr/0022). See the README for the iOS Shortcut setup.
CAPTURE_WEBHOOK_SECRET=
CRON_SECRET=
WIDGET_SECRET=
# Mac EventKit bridge (scripts/mac-calendar-bridge) → POST /api/calendar/bridge
CALENDAR_BRIDGE_SECRET=

# ── iCloud CalDAV (appleid.apple.com → App-Specific Passwords) ─────────────
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Calendar that receives Dispatch-created events (create one named "Dispatch")
ICLOUD_CALENDAR_NAME=Dispatch

# ── Web Push (bunx web-push generate-vapid-keys) ────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:renan@alves.id

# ── Mem.ai one-time import (Phase 9) ────────────────────────────────────────
MEM_API_KEY=
