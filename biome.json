{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": [
			"**",
			"!.next",
			"!node_modules",
			"!.vercel",
			"!.claude",
			"!.codex",
			"!.impeccable",
			"!docs",
			"!supabase/.temp",
			"!test/e2e/.auth",
			"!test-results",
			"!playwright-report"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@supabase/supabase-js": {
								"importNames": ["SupabaseClient"],
								"message": "Use the typed client type from @/lib/supabase/types (docs/adr/0089)."
							}
						}
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["lib/supabase/types.ts"],
			"linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"css": {
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": false
		},
		"linter": {
			"enabled": false
		}
	}
}
