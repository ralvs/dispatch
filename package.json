		"@modelcontextprotocol/server": "^2.4.0",
		"@supabase/auth-js": "2.119.2",
		"@supabase/postgrest-js": "2.119.2",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "2.119.2",
		"@tiptap/extension-list": "^3.35.0",
		"@tiptap/extension-paragraph": "^3.35.0",
		"@tiptap/extension-table": "^3.35.0",
		"@tiptap/extension-task-item": "^3.35.0",
		"@tiptap/extension-task-list": "^3.35.0",
		"@tiptap/extension-text": "^3.35.0",
		"@tiptap/pm": "^3.35.0",
		"@tiptap/react": "^3.35.0",
		"@tiptap/starter-kit": "^3.35.0",
		"@tiptap/suggestion": "^3.35.0",
		"ai": "^7.0.177",
		"aws4fetch": "^1.0.20",
		"ical.js": "^2.2.1",
		"lucide-react": "^1.77.0",
		"luxon": "^3.7.2",
		"motion": "^14.14.0",
		"next": "^16.4.6",
		"notch-toast": "^0.2.0",
		"react": "^19.3.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.1",
