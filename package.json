{
	"name": "dispatch",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --project unit --project component",
		"test:integration": "vitest run --project integration",
		"test:e2e": "playwright test",
		"test:watch": "vitest --project unit --project component",
		"eval:parser": "bun --conditions=react-server scripts/parser-eval.ts",
		"smoke:pluggy": "bun --conditions=react-server scripts/pluggy-smoke.ts",
		"db:types": "supabase gen types typescript --local --schema public > lib/database.types.gen.ts && biome format --write lib/database.types.gen.ts && mv lib/database.types.gen.ts lib/database.types.ts",
		"backfill:links": "bun --conditions=react-server scripts/backfill-link-metadata.ts",
		"check": "biome check . && tsc --noEmit && vitest run --project unit --project component"
	},
	"dependencies": {
		"@ai-sdk/gateway": "^4.0.150",
